        permission_tbl ps1_1 
            on ps1_1.id=ps1_0.permission) 
        on rs1_1.name=ps1_0.role_name 
        and ( ps1_1.deleted = 0) 
    where
        u1_0.username=? 
        and (
            u1_0.deleted = 0
        )
