        rs1_1.name,
        rs1_1.deleted,
        ps1_0.role_name,
        ps1_1.id,
        ps1_1.deleted,
        ps1_1.permission 
    from
        user_tbl u1_0 
    left join
        (user_role_tbl rs1_0 
    join
        role_tbl rs1_1 
            on rs1_1.name=rs1_0.role_name) 
        on u1_0.username=rs1_0.username 
        and ( rs1_1.deleted = 0) 
    left join
        (role_permission_tbl ps1_0 
