            on u1_0.username=p1_0.username 
            and (u1_0.deleted = 0) 
    left join
        (user_role_tbl rs1_0 
    join
        role_tbl rs1_1 
            on rs1_1.name=rs1_0.role_name) 
        on u1_0.username=rs1_0.username 
        and ( rs1_1.deleted = 0) 
    left join
        (role_permission_tbl ps1_0 
    join
        permission_tbl ps1_1 
            on ps1_1.id=ps1_0.permission) 
        on rs1_1.name=ps1_0.role_name 
        and ( ps1_1.deleted = 0) 
    where
        p1_0.id=? 
        and (
            p1_0.deleted = 0
        )
